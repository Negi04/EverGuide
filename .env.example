# Copy to `.env` (server) and `client/.env.local` (client) and fill in values.
# Never commit real credentials.

# ---------- Client (exposed to the browser — public values only) ----------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_RAZORPAY_KEY_ID=

# ---------- Server (secret — backend only) ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, usually 1 on Render/Railway)
TRUST_PROXY=0
LOG_LEVEL=info

SUPABASE_URL=
# Publishable key (sb_publishable_…)
SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) — bypasses RLS, server only
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
