# Copy to `.env` (server) and `client/.env.local` (client) and fill in values.
# Never commit real credentials.

# ---------- Client (exposed to the browser — public values only) ----------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------- Server (secret — backend only) ----------
NODE_ENV=development
PORT=4000
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, usually 1 on Render/Railway)
TRUST_PROXY=0
LOG_LEVEL=info

SUPABASE_URL=
# Publishable key (sb_publishable_…)
SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) — bypasses RLS, server only
SUPABASE_SERVICE_ROLE_KEY=

# AI Guide (without a key the API runs and AI endpoints return 503)
GEMINI_API_KEY=
# Defaults: gemini-2.5-flash and gemini-embedding-001 (768 dims). Changing the
# embedding model requires re-ingesting the knowledge base.
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=
# AI answers per user per calendar month (default 30)
AI_FREE_MONTHLY_MESSAGES=
# Retrieval tuning — defaults chosen with `npm run kb:eval -w @everguide/server`
RAG_MIN_SIMILARITY=
RAG_MATCH_COUNT=

# Demo payments: Razorpay TEST MODE keys only (rzp_test_…). Live keys are refused.
# The browser gets the key id from the server with each order, so no VITE_ copy is needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: the secret you choose when adding a webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Automation (n8n). The Production URL of the EverGuide Webhook node, and a shared
# secret of 32+ random characters (generate with: openssl rand -hex 32). Both or neither.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
